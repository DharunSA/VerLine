# Verline Environment Variables Example
# Copy this file to `.env.local` to enable live production AI features.

# ─── Live Production AI Configuration ──────────────────────────────────────────

# Primary LLM: Google Gemini Flash (via Google AI Studio)
# Best overall language understanding for complex/messy real-world sentences.
VITE_GEMINI_API_KEY=AIzaSy...

# Fast Path / Fallback LLM: Groq (Llama 3.1 8B Instant)
# Sub-second fast-path responses and fallback when Gemini Flash is rate-limited.
VITE_GROQ_API_KEY=gsk_...

# ─── Supabase Credentials (Optional for Cloud Persistence & Edge Functions) ─────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Note for Supabase Edge Functions (if using serverless proxy):
# Set keys in Supabase Edge Secrets via CLI:
# supabase secrets set GEMINI_API_KEY=AIzaSy...
# supabase secrets set GROQ_API_KEY=gsk_...
