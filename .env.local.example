# Verline Environment Variables Example
# Copy this file to `.env.local` to connect your Supabase backend.

# Supabase Credentials (Required for persistence and Edge Functions)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Note for AI Features:
# Set your Anthropic API Key in Supabase Edge Function Secrets using:
# supabase secrets set ANTHROPIC_API_KEY=sk-ant-api03-...
